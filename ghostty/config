theme = Kanagawa Dragon
font-family = Comic Mono
font-size = 13

window-padding-x = 10
window-padding-y = 10
macos-option-as-alt = true

# option-as-alt above steals alt+left/right from the shell's word
# navigation; give them back
keybind = alt+left=unbind
keybind = alt+right=unbind

# per-OS overlay, linked by install.sh: the open/new-tab keybinds use a
# different modifier on each OS to land on the same physical keys
config-file = ?os.conf
