# Allowlist: everything is ignored unless explicitly permitted below.
# A file that is not listed here does not get committed by accident.
/*

!.gitignore
!.gitmodules
!install.sh
!archive
!ghostty
!git
!packages
!ptyxis
!ssh
!tmux
!xdg
!zed
!zsh

# Denied again inside the permitted directories
**/.DS_Store
**/*.log
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/known_hosts
